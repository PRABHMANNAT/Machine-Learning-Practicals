# Copy this file to secrets.toml before configuring a real login.  # The copied filename is intentionally ignored by Git.
[auth]  # Streamlit reads shared OpenID Connect settings from this section.
redirect_uri = "http://localhost:8501/oauth2callback"  # The identity provider sends the browser back to this URL.
cookie_secret = "replace-with-a-long-random-secret"  # A real random value protects the login cookie.
client_id = "replace-with-provider-client-id"  # Your identity provider gives your app this public identifier.
client_secret = "replace-with-provider-client-secret"  # This sensitive value must never be committed.
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"  # This example URL describes Google's OIDC endpoints.
